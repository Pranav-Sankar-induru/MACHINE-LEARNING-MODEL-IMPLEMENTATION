import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.naive_bayes import MultinomialNB
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
import matplotlib.pyplot as plt
import seaborn as sns
import joblib

class SpamDetector:
    """A machine learning model to classify emails as spam or ham."""
    
    def __init__(self):
        self.model = MultinomialNB()
        self.vectorizer = TfidfVectorizer(max_features=5000, stop_words="english")
        self._initialize_data()

    def _initialize_data(self):
        """Load and preprocess the dataset."""
        url = "https://raw.githubusercontent.com/mohitgupta-omg/Kaggle-SMS-Spam-Collection-Dataset-/master/spam.csv"
        self.data = pd.read_csv(url, encoding="latin-1")[["v1", "v2"]]
        self.data.columns = ["label", "message"]
        self.data["label"] = self.data["label"].map({"ham": 0, "spam": 1})

    def _visualize_data(self):
        """Display label distribution."""
        sns.countplot(x=self.data["label"])
        plt.title("Label Distribution (0 = Ham, 1 = Spam)")
        plt.show()

    def prepare_features(self):
        """Transform text data into TF-IDF features."""
        X = self.data["message"]
        y = self.data["label"]
        X_tfidf = self.vectorizer.fit_transform(X)
        return train_test_split(X_tfidf, y, test_size=0.2, random_state=42)

    def train_model(self, X_train, y_train):
        """Train the Naive Bayes classifier."""
        self.model.fit(X_train, y_train)

    def evaluate_model(self, X_test, y_test):
        """Evaluate model performance."""
        y_pred = self.model.predict(X_test)
        
        print(f"Model Accuracy: {accuracy_score(y_test, y_pred):.4f}")
        print("\nClassification Report:")
        print(classification_report(y_test, y_pred))
        
        conf_matrix = confusion_matrix(y_test, y_pred)
        sns.heatmap(conf_matrix, annot=True, fmt="d", cmap="Blues",
                   xticklabels=["Ham", "Spam"], yticklabels=["Ham", "Spam"])
        plt.title("Confusion Matrix")
        plt.xlabel("Predicted")
        plt.ylabel("Actual")
        plt.show()

    def predict(self, text):
        """Classify a single text input."""
        features = self.vectorizer.transform([text])
        return "Spam" if self.model.predict(features)[0] == 1 else "Ham"

    def save_model(self):
        """Save model and vectorizer to disk."""
        joblib.dump(self.model, "spam_classifier_model.pkl")
        joblib.dump(self.vectorizer, "tfidf_vectorizer.pkl")
        print("Model and vectorizer saved successfully.")

def main():
    """Main execution function."""
    detector = SpamDetector()
    
    # Display data distribution
    detector._visualize_data()
    
    # Prepare and split data
    X_train, X_test, y_train, y_test = detector.prepare_features()
    
    # Train and evaluate model
    detector.train_model(X_train, y_train)
    detector.evaluate_model(X_test, y_test)
    
    # Test with custom input
    test_email = "Congratulations! You've won a $1000 gift card!"
    print(f"\nTest Prediction: '{test_email}' → {detector.predict(test_email)}")
    
    # Save model
    detector.save_model()

if __name__ == "__main__":
    main()
